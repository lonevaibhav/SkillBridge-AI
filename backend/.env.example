# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/skillbridge_ai
DATABASE_NAME=skillbridge_ai

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FAISS Vector Store Path
FAISS_INDEX_PATH=./data/faiss_index
DATA_DIR=./data

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176


# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt
